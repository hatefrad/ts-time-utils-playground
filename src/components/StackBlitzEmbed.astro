---
interface Props {
  code: string;
  title?: string;
  height?: number;
}

const { code, title = 'ts-time-utils playground', height = 400 } = Astro.props;
const id = `stackblitz-${Math.random().toString(36).slice(2, 9)}`;
---

<div id={id} class="stackblitz-embed rounded-lg overflow-hidden border border-gray-700" data-code={code} data-title={title} style={`height: ${height}px`}></div>

<script>
  import sdk from '@stackblitz/sdk';

  document.querySelectorAll('.stackblitz-embed').forEach((container) => {
    const el = container as HTMLElement;
    if (el.dataset.initialized) return;
    el.dataset.initialized = 'true';

    const code = el.dataset.code || '';
    const title = el.dataset.title || 'ts-time-utils playground';

    sdk.embedProject(el, {
      title,
      template: 'typescript',
      dependencies: { 'ts-time-utils': '4.4.1' },
      files: {
        'index.html': '<script type="module" src="/index.ts"></scr' + 'ipt>',
        'index.ts': code,
        'tsconfig.json': JSON.stringify({
          compilerOptions: {
            target: 'ES2020',
            module: 'ESNext',
            strict: true
          }
        }, null, 2)
      },
      settings: {
        compile: { trigger: 'auto' }
      }
    }, {
      height: parseInt(el.style.height) || 400,
      openFile: 'index.ts',
      terminalHeight: 30
    });
  });
</script>
