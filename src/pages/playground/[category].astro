---
import Layout from '../../layouts/Layout.astro';
import StackBlitzEmbed from '../../components/StackBlitzEmbed.astro';
import { categories, type Category } from '../../data/examples';

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
const currentIndex = categories.findIndex(c => c.slug === category.slug);
const prevCategory = currentIndex > 0 ? categories[currentIndex - 1] : null;
const nextCategory = currentIndex < categories.length - 1 ? categories[currentIndex + 1] : null;
---

<Layout title={`${category.name} Playground`}>
  <div class="flex gap-8">
    <!-- Sidebar -->
    <aside class="w-48 shrink-0 hidden md:block">
      <nav class="sticky top-24">
        <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Categories</h3>
        <ul class="space-y-1">
          {categories.map(({ name, slug }) => (
            <li>
              <a
                href={`/playground/${slug}`}
                class:list={[
                  'block px-3 py-1.5 rounded text-sm transition-colors',
                  slug === category.slug
                    ? 'bg-blue-600 text-white'
                    : 'text-gray-400 hover:text-white hover:bg-gray-800'
                ]}
              >
                {name}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 min-w-0">
      <header class="mb-8">
        <h1 class="text-3xl font-bold mb-2">{category.name}</h1>
        <p class="text-gray-400">{category.description}</p>
        <p class="text-sm text-gray-500 mt-3">Each playground launches with `ts-time-utils@4.4.1` so the code matches the current release.</p>
      </header>

      <div class="space-y-12">
        {category.examples.map((example, i) => (
          <section>
            <h2 class="text-xl font-semibold mb-2">{example.title}</h2>
            <p class="text-gray-400 text-sm mb-4">{example.description}</p>
            <StackBlitzEmbed code={example.code} height={400} />
          </section>
        ))}
      </div>

      <!-- Navigation -->
      <nav class="flex justify-between mt-12 pt-8 border-t border-gray-800">
        {prevCategory ? (
          <a href={`/playground/${prevCategory.slug}`} class="text-blue-400 hover:text-blue-300">
            ← {prevCategory.name}
          </a>
        ) : <span />}
        {nextCategory ? (
          <a href={`/playground/${nextCategory.slug}`} class="text-blue-400 hover:text-blue-300">
            {nextCategory.name} →
          </a>
        ) : <span />}
      </nav>
    </main>
  </div>
</Layout>
